<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude
            domain="file"
            path="rust-log" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="rust-log" />
    </device-transfer>
</data-extraction-rules>
