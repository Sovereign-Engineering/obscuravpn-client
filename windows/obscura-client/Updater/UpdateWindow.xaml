<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Obscura_Client.Updater.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="Obscura VPN Update"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="{StaticResource AppLogoImage}" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap" />

            <!-- Notes area: sizes to its content but never taller than MaxHeight, scrolling beyond. -->
            <Border x:Name="NotesBorder"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer x:Name="NotesScroll"
                              MaxHeight="600"
                              Padding="8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- DisableHtml strips any raw HTML in the markdown; the control renders
                         natively to XAML, so no JavaScript can ever execute. -->
                    <controls:MarkdownTextBlock x:Name="ReleaseNotes"
                                                DisableHtml="True"
                                                IsTextSelectionEnabled="False" />
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="ProgressPanel"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Spacing="4"
                        Visibility="Collapsed">
                <ProgressBar x:Name="DownloadProgress"
                             Minimum="0" Maximum="100" />
                <TextBlock x:Name="ProgressText"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       Margin="0,8,0,0"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Grid.Row="4"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="LaterButton" Content="Not Now" Click="OnLaterClick" />
                <Button x:Name="InstallButton"
                        Content="Install and Relaunch"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnInstallClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
